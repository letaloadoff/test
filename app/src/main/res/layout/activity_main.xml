<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TimePicker
        android:id="@+id/timePicker"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:is24HourView="true" />

    <EditText
        android:id="@+id/editLabel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="@string/hint_alarm_label" />

    <CheckBox
        android:id="@+id/checkVibrate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_vibrate" />

    <CheckBox
        android:id="@+id/checkSkipUi"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/label_skip_ui" />

    <Button
        android:id="@+id/buttonSetAlarm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/btn_set_alarm" />

</LinearLayout>